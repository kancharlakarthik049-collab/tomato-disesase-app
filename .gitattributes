# Git LFS Configuration for Large Model Files
# These files are tracked by Git LFS to avoid bloating the repository
# Model files (.h5, .pb, .tflite, etc.) are stored on LFS server, not in git history

# Keras/TensorFlow models
models/*.h5 filter=lfs diff=lfs merge=lfs -text
tomato_disease_app/models/*.h5 filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text

# TensorFlow SavedModel / Protocol Buffer format
models/*.pb filter=lfs diff=lfs merge=lfs -text
*.pb filter=lfs diff=lfs merge=lfs -text

# TensorFlow Lite models
models/*.tflite filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text

# ONNX models
*.onnx filter=lfs diff=lfs merge=lfs -text

# PyTorch models
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text

# Pickle files
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pickle filter=lfs diff=lfs merge=lfs -text

# Large archives
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
