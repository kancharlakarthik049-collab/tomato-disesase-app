# Flask Environment Variables - Tomato Disease Identification App
# Copy this file to .env and update values for your environment
# DO NOT commit .env file to Git (it contains sensitive information)

# ========================================
# FLASK / APPLICATION CONFIGURATION
# ========================================

# Flask environment (development or production)
# development = Debug mode enabled; production = Debug mode disabled
FLASK_ENV=production

# Flask app instance
FLASK_APP=app:app

# Port for the application (Render sets this automatically)
# For local development, use 5000
PORT=5000

# ========================================
# GUNICORN SERVER CONFIGURATION
# ========================================

# Number of Gunicorn workers (processes)
# For free tier Render: use 1 (avoids memory bloat with TensorFlow model)
# For paid tier: can increase to 2-4
GUNICORN_WORKERS=1

# Number of threads per worker
# Increase for higher throughput: 4-8 is typical
GUNICORN_THREADS=4

# Worker timeout in seconds
# IMPORTANT: InceptionV3 inference takes 1-5 seconds
# Set timeout to at least 120 seconds to avoid timeouts
GUNICORN_TIMEOUT=120

# ========================================
# MODEL LOADING & ML CONFIGURATION
# ========================================

# Option A: Model in Git repository (default)
# Model is committed to GitHub (with Git LFS for ~151 MB file)
# Leave MODEL_URL empty

# Option B: Model on external server (Google Drive, AWS S3, etc.)
# Set MODEL_URL to the file ID or URL
# For Google Drive: MODEL_URL=<file_id_from_shareable_link>
# The app will download the model at startup if missing
MODEL_URL=

# Path to the model file (relative to app root)
# Default: models/tomato_model.h5
MODEL_PATH=models/tomato_model.h5

# ========================================
# TOMATO LEAF DETECTION THRESHOLDS
# ========================================

# HSV color space thresholds for detecting green leaves
# These are used for pre-filtering images (quality check)

# Hue range for green color (0-255)
# Green is approximately 25-100 in OpenCV's HSV scale
GREEN_H_MIN=25
GREEN_H_MAX=100

# Minimum saturation (0-255)
# Higher = more saturated (more vibrant colors)
S_MIN=40

# Minimum value/brightness (0-255)
# Higher = brighter pixels only
V_MIN=40

# Minimum proportion of green pixels required to accept image (0.0-1.0)
# 0.03 = at least 3% of image must be green
GREEN_PROP_THRESH=0.03

# Prediction confidence threshold
# If model confidence < this, prediction marked as "Uncertain"
CONF_THRESH=0.4

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================

# Maximum file upload size (bytes)
# 16 MB = 16 * 1024 * 1024 = 16777216
MAX_CONTENT_LENGTH=16777216

# Allowed file extensions for upload (comma-separated)
ALLOWED_EXTENSIONS=png,jpg,jpeg

# Upload directory
UPLOAD_FOLDER=static/uploads

# Debug mode for uploads (saves uploaded images for inspection)
DEBUG_MODE=false

# ========================================
# CORS CONFIGURATION
# ========================================

# Allowed origins for Cross-Origin Resource Sharing
# For public API, use: *
# For restricted deployment, use: https://yourdomain.com
CORS_ORIGINS=*

# ========================================
# OPTIONAL: ADMIN PANEL CONFIGURATION
# ========================================

# Basic auth username for /admin endpoint (optional)
# If set, /admin requires authentication
# ADMIN_USERNAME=admin

# Basic auth password for /admin endpoint (optional)
# Use a strong password in production!
# ADMIN_PASSWORD=your_secure_password

# ========================================
# LOGGING & DEBUGGING
# ========================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Save debug logs and uploaded images for analysis
SAVE_DEBUG_LOGS=true

# Debug logs directory
DEBUG_LOG_DIR=static/uploads/debug

# ========================================
# RENDER-SPECIFIC CONFIGURATION
# ========================================

# Render sets these automatically; you can override if needed

# Service name (from Render dashboard)
# RENDER_SERVICE_NAME=tomato-disease-detector

# Deployment environment URL (set by Render)
# RENDER_EXTERNAL_URL=https://tomato-disease-detector.onrender.com

# ========================================
# NOTES
# ========================================

# 1. NEVER commit .env file to Git
#    It contains secrets and configuration specific to your environment

# 2. For production (Render):
#    Set these as environment variables in Render Dashboard:
#    - Settings → Environment Variables

# 3. For local development:
#    Copy this file to .env and update values
#    source .env  (on Linux/macOS)
#    or use PowerShell on Windows

# 4. Git LFS Configuration:
#    The model file (tomato_model.h5) is tracked with Git LFS
#    Install Git LFS before cloning: git lfs install

# 5. Model Download (Option B):
#    If using external model storage:
#    a) Upload model to Google Drive
#    b) Get file ID from shareable link
#    c) Set MODEL_URL=<file_id>
#    d) Install gdown: pip install gdown

# ========================================
